# NEXT_PUBLIC_API_URL: Required for Gemini AI API calls.
#  automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the  UI.
NEXT_PUBLIC_API_URL="MY_NEXT_PUBLIC_API_URL"

# APP_URL: The URL where this applet is hosted.
#  automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:3001"
