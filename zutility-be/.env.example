APP_ENV=dev
HTTP_BIND_ADDR=127.0.0.1:3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zutility
ORDER_TOKEN_HMAC_SECRET=replace_with_64_plus_random_chars
IP_HASH_SECRET=replace_with_64_plus_random_chars
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=replace_with_vtpass_key
VTPASS_SECRET_KEY=replace_with_vtpass_secret
REMITA_MERCHANT_ID=replace_with_remita_merchant_id
REMITA_API_KEY=replace_with_remita_api_key
REMITA_SERVICE_TYPE_ID=replace_with_remita_service_type_id
REMITA_BASE_URL=https://remitademo.net/remita/exapp/api/v1
REMITA_WEBHOOK_SECRET=replace_with_remita_webhook_secret
INLOMAX_API_KEY=
INLOMAX_BASE_URL=
INLOMAX_WEBHOOK_SECRET=
ZCASH_BACKEND=zingolib
ZCASH_NETWORK=testnet
ZINGO_INDEXER_URI=http://127.0.0.1:19067
ZINGO_WALLET_DIR=/var/lib/zutility/wallet
ZINGO_WALLET_BIRTHDAY=0
ZINGO_INIT_TIMEOUT_SECONDS=90
ZINGO_SYNC_RETRIES=3
ZINGO_SYNC_RETRY_DELAY_MS=2000
ZCASH_RPC_MODE=unix
ZCASH_RPC_SOCKET_PATH=/var/run/zcashd/zcashd.sock
ZCASH_RPC_URL=http://127.0.0.1:18232
ZCASH_RPC_USER=replace_with_rpc_user
ZCASH_RPC_PASSWORD=replace_with_rpc_password
REQUIRED_CONFS_TRANSPARENT=9
REQUIRED_CONFS_SHIELDED=10
ORDER_EXPIRY_MINUTES=30
RATE_LOCK_MINUTES=15
SWEEP_THRESHOLD_ZEC=0.5
SIGNING_SERVICE_URL=http://10.0.0.2:8080
SIGNING_SERVICE_HMAC_SECRET=replace_with_shared_hmac_secret
RATE_SOURCE_TIMEOUT_MS=3000
JWT_SECRET=replace_with_64_plus_random_chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=24
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=
ADMIN_SECRET=replace_with_admin_secret
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
